# Copy the values you need into your shell or the App Platform settings.
# The app reads environment variables only; it does not load this file.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=cancellations.example.com
CSRF_TRUSTED_ORIGINS=https://cancellations.example.com
TIME_ZONE=Africa/Nairobi
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://imoth:password@localhost:5432/imoth_cancellations
DB_SSL_REQUIRE=false
DB_CONN_MAX_AGE=60

# --- Email ---
EMAIL_PROVIDER=postmark            # postmark | mailgun | console
MAIL_DOMAIN=example.com            # replies go to cancellations+CXL000123@MAIL_DOMAIN
CANCELLATIONS_MAILBOX=cancellations
DEFAULT_FROM_EMAIL=IMOTH Cancellations <cancellations@example.com>
INBOUND_WEBHOOK_SECRET=webhookuser:long-random-password   # HTTP Basic auth on the inbound webhook
INBOUND_AUTHSERV_ID=               # authserv-id of your provider's Authentication-Results header (optional)
INBOUND_REQUIRE_SENDER_AUTH=true

# Postmark
POSTMARK_SERVER_TOKEN=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=example.com
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_API_URL=                   # https://api.eu.mailgun.net/v3 for EU accounts

# --- File storage (DigitalOcean Spaces / any S3) ---
# Leave AWS_STORAGE_BUCKET_NAME empty to store files in PRIVATE_MEDIA_ROOT on local disk (dev only).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
AWS_S3_REGION_NAME=fra1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_LOCATION=case-documents
PRIVATE_MEDIA_ROOT=
MAX_UPLOAD_MB=10
