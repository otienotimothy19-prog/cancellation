# Copy the values you need into your shell or the App Platform settings.
# The app reads environment variables only; it does not load this file.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=cancellations.imoth.co.ke
CSRF_TRUSTED_ORIGINS=https://cancellations.imoth.co.ke
TIME_ZONE=Africa/Nairobi
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://imoth:password@localhost:5432/imoth_cancellations
DB_SSL_REQUIRE=false
DB_CONN_MAX_AGE=60

# --- Email: Zoho Mail (SMTP send + IMAP read) ---
EMAIL_PROVIDER=zoho                # zoho | postmark | mailgun | console
MAIL_DOMAIN=imoth.co.ke
CANCELLATIONS_MAILBOX=cancellation # replies go to cancellation+CXL000123@imoth.co.ke
MAILBOX_USER=cancellation@imoth.co.ke
MAILBOX_PASSWORD=                  # Zoho app-specific password
DEFAULT_FROM_EMAIL=IMOTH Cancellations <cancellation@imoth.co.ke>
SMTP_HOST=smtppro.zoho.com         # smtppro.zoho.eu etc. for other data centres
SMTP_PORT=465
IMAP_HOST=imappro.zoho.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=14
MAIL_POLL_INTERVAL=60

# --- Inbound sender verification ---
INBOUND_REQUIRE_SENDER_AUTH=true
INBOUND_AUTH_HEADER=Authentication-Results   # or ARC-Authentication-Results; check with manage.py check_mailbox
INBOUND_AUTHSERV_ID=mx.zohomail.com

# --- Exports / API ---
CURRENCY=KES
EXPORT_API_TOKENS=                 # e.g. a long random token for the commission system

# --- SLA ---
SLA_ALERT_EMAIL=cancellation@imoth.co.ke   # used when the case creator has no email address
SLA_STALE_AFTER_REMINDER_HOURS=24
SLA_CHECK_INTERVAL=300
APP_BASE_URL=https://cancellations.imoth.co.ke

# --- Alternative providers (only if EMAIL_PROVIDER=postmark/mailgun) ---
INBOUND_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_API_URL=

# --- File storage (DigitalOcean Spaces / any S3) ---
# Leave AWS_STORAGE_BUCKET_NAME empty to store files in PRIVATE_MEDIA_ROOT on local disk (dev only).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
AWS_S3_REGION_NAME=fra1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_LOCATION=case-documents
PRIVATE_MEDIA_ROOT=
MAX_UPLOAD_MB=10
